<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <title>Resumen de atención</title>
    <style>
        @page {
            size: letter;
            margin: 22mm 20mm 20mm;
        }
        body {
            color: #212529;
            font-family: Helvetica, Arial, sans-serif;
            font-size: 10pt;
            line-height: 1.45;
        }
        .header {
            border-bottom: 2px solid #1a2a6c;
            margin-bottom: 10pt;
            padding: 0 0 5pt;
            text-align: center;
        }
        .logo {
            height: 54pt;
            margin-bottom: 8pt;
            background-color: #1a2a6c;
        }
        .eyebrow {
            color: #596579;
            font-size: 8pt;
            font-weight: bold;
            text-transform: uppercase;
        }
        h1 {
            color: #1a2a6c;
            font-size: 20pt;
            margin: 1pt 0 0;
        }
        h2 {
            border-bottom: 1px solid #d8dee8;
            color: #1a2a6c;
            font-size: 10pt;
            margin: 8pt 0 8pt;
            padding-bottom: 5pt;
            text-transform: uppercase;
        }
        table {
            border-collapse: collapse;
            width: 100%;
        }
        .field {
            padding: 2pt 2pt 2pt 0;
            vertical-align: top;
            width: 50%;
        }
        .person-field .value {
            color: #1a2a6c;
            font-size: 14pt;
        }
        .folio-field {
            background-color: #f1f4f8;
            border-left: 2pt solid #1a2a6c;
            padding-left: 9pt;
        }
        .label {
            color: #596579;
            font-size: 8pt;
            margin-bottom: 1pt;
            text-transform: uppercase;
        }
        .value {
            color: #212529;
            font-size: 11pt;
            font-weight: bold;
        }
        .folio {
            color: #1a2a6c;
            font-size: 18pt;
        }
        .qr-cell {
            padding-top: 4pt;
            text-align: right;
            vertical-align: middle;
            width: 100pt;
        }
        .qr-placeholder {
            border: 1px dashed #8b95a5;
            color: #596579;
            font-size: 7pt;
            height: 76pt;
            padding-top: 8pt;
            text-align: center;
            width: 76pt;
        }
        .footer {
            border-top: 1px solid #d8dee8;
            color: #596579;
            font-size: 8pt;
            margin-top: 26pt;
            padding-top: 7pt;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="header">
        <img class="logo" src="{{ url_for('static', filename='img/logo.png') }}" alt="Poder Judicial del Estado de Coahuila">
        <div class="eyebrow">Defensoría</div>        
    </div>

    <h2>Información de la persona</h2>
    <table>
        <tr>
            <td class="field person-field" colspan="2">
                <div class="label">Persona</div>
                <div class="value">{{ persona }}</div>
            </td>
        </tr>
        <tr>
            <td class="field">
                <div class="label">Expediente</div>
                <div class="value">{{ expediente }}</div>
            </td>
            <td class="field folio-field">
                <div class="label">Folio</div>
                <div class="value folio">{{ folio }}</div>
            </td>
        </tr>
        <tr>
            <td class="field" colspan="2">
                <div class="label">Tipo de atención</div>
                <div class="value">{{ tipo_atencion }}</div>
            </td>
        </tr>
    </table>

    <h2>Cita</h2>
    <table>
        <tr>
            <td class="field">
                <div class="label">Fecha de siguiente cita</div>
                <div class="value">{{ fecha_cita }}</div>
            </td>
        </tr>
    </table>

    <h2>Defensoría</h2>
    <table>
        <tr>
            <td class="field">
                <div class="label">Defensor designado</div>
                <div class="value">{{ defensor }}</div>
            </td>
            <td class="qr-cell">
                <div class="qr-placeholder">ESPACIO RESERVADO<br>PARA QR</div>
            </td>
        </tr>
    </table>

    <div class="footer">Sistema de Atención de Defensoría</div>
</body>
</html>